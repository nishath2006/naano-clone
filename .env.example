# Copy to .env.local for local development (the file is git-ignored).
# In production, set the same variables in Vercel → Project → Settings → Environment Variables.
#
# Both values are PUBLIC: the project URL and the anon / publishable key.
# Never put the service-role key or the database password here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# --- Optional, for `node scripts/seed.mjs` ONLY (run locally, never shipped to the browser) ---
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
